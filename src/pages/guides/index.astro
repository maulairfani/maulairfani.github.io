---
import '../../styles/global.css';
import { publishedGuides } from '../../data/guides';

const title = 'Study Guides';
const description = 'All study guides on irfani.me: small, interactive notes on AI and machine learning topics.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title} · Maula Irfani</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body class="bg-white font-body text-neutral-900 antialiased">
    <main class="mx-auto max-w-2xl px-5 pb-12 pt-10 sm:pt-16">
      <nav class="font-label text-xs uppercase tracking-[0.12em]">
        <a href="/" class="underline underline-offset-4 hover:no-underline">← Maula Irfani</a>
      </nav>

      <header class="mt-6 border-t-[6px] border-black pt-3">
        <p class="font-label text-[11px] font-bold uppercase tracking-[0.12em]">Index · {publishedGuides.length} guides</p>
        <h1 class="mt-3 font-display text-4xl font-bold leading-[1.1] tracking-tight">{title}</h1>
        <p class="mt-4 font-body text-lg leading-relaxed text-neutral-800">{description}</p>
      </header>

      <section class="mt-10 border-t-[3px] border-black pt-4" aria-labelledby="all-guides">
        <h2 id="all-guides" class="font-label text-[11px] font-bold uppercase tracking-[0.12em]">All guides</h2>
        <ul class="mt-4 border-t border-neutral-400">
          {
            publishedGuides.map((g) => (
              <li class="border-b border-neutral-400 py-4">
                <a href={g.path} class="group block">
                  <span class="font-display text-lg font-bold leading-snug group-hover:underline underline-offset-4">
                    {g.title}
                  </span>
                </a>
                <p class="mt-1 text-sm text-neutral-700">{g.description}</p>
                <p class="mt-2 font-label text-xs uppercase tracking-[0.08em] text-neutral-600">
                  {g.tags.join(' · ')}
                  {g.updated && (
                    <>
                      {' · Updated '}
                      <time datetime={g.updated}>{g.updated}</time>
                    </>
                  )}
                </p>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
  </body>
</html>
