---
import '../styles/global.css';
import { publishedGuides } from '../data/guides';
import ThemeScript from '../components/ThemeScript.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const title = 'Maula Irfani';
const description = "I'm an AI/ML engineer based in Jakarta, and this is where I share my little experiments.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <ThemeScript />
  </head>
  <body class="bg-white font-body text-neutral-900 antialiased dark:bg-neutral-950 dark:text-neutral-100">
    <main class="mx-auto max-w-2xl px-5 pb-12 pt-10 sm:pt-16">
      <header class="border-t-[6px] border-black pt-3 dark:border-neutral-100">
        <div class="flex items-center justify-between">
          <p class="font-label text-[11px] font-bold uppercase tracking-[0.12em]">Jakarta · AI/ML</p>
          <ThemeToggle />
        </div>
        <h1 class="mt-3 font-body text-4xl font-bold leading-[1.1] tracking-tight">Maula Irfani</h1>
        <p class="mt-4 font-body text-lg leading-relaxed text-neutral-800 dark:text-neutral-300">
          I'm an AI/ML engineer based in Jakarta, and this is where I share my little experiments.
        </p>
        <p class="mt-5 font-label text-xs uppercase tracking-[0.12em]">
          <a class="underline underline-offset-4 hover:no-underline" href="https://github.com/maulairfani">GitHub</a>
          <span aria-hidden="true"> · </span>
          <a class="underline underline-offset-4 hover:no-underline" href="https://www.linkedin.com/in/maula-irfani/">LinkedIn</a>
          <span aria-hidden="true"> · </span>
          <a class="underline underline-offset-4 hover:no-underline" href="mailto:maulairfani15@gmail.com">Email</a>
        </p>
      </header>

      <section class="mt-12 border-t-[3px] border-black pt-4 dark:border-neutral-100">
        <h2 class="font-label text-[11px] font-bold uppercase tracking-[0.12em]">Study Guides</h2>
        <ul class="mt-4 border-t border-neutral-400">
          {
            publishedGuides.map((g) => (
              <li class="border-b border-neutral-400">
                <a href={g.path} class="group block py-4">
                  <span class="font-display text-lg font-bold leading-snug group-hover:underline underline-offset-4">
                    {g.title}
                  </span>
                  <span class="mt-1 block text-sm text-neutral-700 dark:text-neutral-400">{g.description}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 font-label text-xs uppercase tracking-[0.12em]">
          <a href="/guides/" class="underline underline-offset-4 hover:no-underline">All guides →</a>
        </p>
      </section>
    </main>
  </body>
</html>
