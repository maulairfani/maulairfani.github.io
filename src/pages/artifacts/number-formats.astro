---
const target = '/guides/number-formats/';
const url = new URL(target, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={url} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex" />
    <title>Moved · Maula Irfani</title>
  </head>
  <body class="bg-white font-body text-neutral-900 antialiased">
    <main class="mx-auto max-w-2xl px-5 pb-12 pt-10">
      <p>
        This guide has moved to <a href={target} class="underline underline-offset-4">{url.href}</a>.
      </p>
    </main>
  </body>
</html>
