---
import { projects } from '../data/projects';
import { site } from '../data/site';
---

<section id="work">
  <div class="sec-head">
    <div class="sec-num"><b>§ 02</b> &nbsp;— Selected work</div>
    <h2 class="sec-title">Things I've made,<br />roughly in order.</h2>
  </div>

  <div class="work-list">
    {
      projects.map((p, i) => (
        <article class:list={['work', p.featured && 'featured']}>
          <div class="idx">№ {String(i + 1).padStart(2, '0')}</div>
          <div>
            <h3>
              {p.title} <em>— {p.tagline}</em>
            </h3>
            <div class="tags">{p.tags.join(' · ')}</div>
          </div>
          <div class="desc">{p.description}</div>
          <div class="yr">{p.year}</div>
          {p.featured && <div class="thumb" data-label={p.thumbLabel ?? 'case study'} />}
        </article>
      ))
    }
  </div>

  <p class="more-link">
    — a few older experiments live in the attic →
    <a href={site.socials.github} target="_blank" rel="noopener">{site.socials.github.replace('https://', '')}</a>
  </p>
</section>
