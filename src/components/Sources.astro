---
export interface Source {
  title: string;
  url: string;
  author?: string;
  note?: string;
}

interface Props {
  items: Source[];
  heading?: string;
}

const { items, heading = 'Sources' } = Astro.props;
---

{
  items.length > 0 && (
    <section class="border-t border-neutral-200 pt-8">
      <h2 class="text-xs font-medium uppercase tracking-widest text-neutral-400">{heading}</h2>
      <ol class="mt-4 space-y-4 text-sm">
        {items.map((s, i) => (
          <li class="flex gap-3">
            <span class="tabular-nums text-neutral-400">{i + 1}.</span>
            <div>
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-neutral-900 underline underline-offset-4 hover:text-neutral-600"
              >
                {s.title}
                <span aria-hidden="true"> ↗</span>
              </a>
              {s.author && <span class="text-neutral-500"> by {s.author}</span>}
              {s.note && <p class="mt-1 text-neutral-500">{s.note}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>
  )
}
