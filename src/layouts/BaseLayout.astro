---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Maula Irfani — AI Engineer. A quiet corner of the internet.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,300;1,9..144,400;1,9..144,500;1,9..144,600&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300;1,6..72,400&family=JetBrains+Mono:wght@400;500&family=Caveat:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-theme="dusk" data-type="fraunces-newsreader" data-tone="warm" data-grain="true" data-marg="false">
    <div class="wrap">
      <slot />
    </div>
  </body>
</html>
