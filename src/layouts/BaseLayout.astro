---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Maula Irfani — AI/ML Engineer in Jakarta. Building AI-first apps that feel natural to use. Agentic systems, RAG, MCP, fine-tuning, MLOps.',
  image = '/og.svg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  givenName: 'Maula',
  familyName: 'Irfani',
  alternateName: site.name,
  jobTitle: site.role,
  description,
  url: Astro.site?.toString(),
  image: new URL('/pp.jpeg', Astro.site).toString(),
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.location,
    addressCountry: 'ID',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Universitas Airlangga',
  },
  worksFor: {
    '@type': 'Organization',
    name: 'MNC Group',
  },
  knowsAbout: [
    'Artificial Intelligence',
    'Machine Learning',
    'Large Language Models',
    'Retrieval-Augmented Generation',
    'Agentic Systems',
    'Model Context Protocol',
    'MLOps',
    'Fine-tuning',
  ],
  sameAs: [site.socials.github, site.socials.instagram, site.socials.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.domain} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.fullName} — ${site.role}`} />
    <meta property="og:locale" content="en_US" />

    {/* Twitter / X */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* JSON-LD Person schema */}
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    {/* Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,300;1,9..144,400;1,9..144,500;1,9..144,600&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300;1,6..72,400&family=JetBrains+Mono:wght@400;500&family=Caveat:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-theme="dusk" data-type="fraunces-newsreader" data-tone="warm" data-grain="true" data-marg="false">
    <div class="wrap">
      <slot />
    </div>

    <script>
      const targets = document.querySelectorAll('section:not(.hero), footer.colophon');
      targets.forEach((el) => el.classList.add('reveal'));

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -60px 0px' }
      );

      targets.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
